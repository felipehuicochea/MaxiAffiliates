  <li class="nav-item"><a class="nav-link @(current == "Commissions" ? "active" : "")" asp-area="@Plugin.Area" asp-controller="UIAffiliateSettings" asp-action="Commissions" asp-route-storeId="@storeId" id="maxiaff-tab-commissions" text-translate="true">Commissions</a></li>
